---
// Light theme only, so the theme switcher's slot (header + mobile menu footer)
// holds a link back to the MyBelanjawan app instead.
import { Icon } from '@astrojs/starlight/components';

const APP_URL = 'https://app.mybelanjawan.gov.my';
---

<a class="app-link" href={APP_URL}>
	Buka MyBelanjawan
	<Icon name="external" size="1rem" />
</a>

<style>
	/* MYDS primary button, small */
	.app-link {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.375rem 0.75rem;
		border-radius: var(--myds-radius);
		background-color: var(--sl-color-accent);
		color: #ffffff;
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.25rem;
		text-decoration: none;
		white-space: nowrap;
		box-shadow: var(--myds-shadow-button);
		transition: background-color 150ms;
	}

	.app-link:hover,
	.app-link:focus-visible {
		background-color: var(--sl-color-accent-high);
		color: #ffffff;
	}
</style>
